# Local submission demo. Do not expose demo accounts publicly.
DEMO_MODE=true
DATABASE_URL=sqlite:///./backend/data/payment_data.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=45
EMBEDDING_MODE=tfidf
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80
# Required unique secret when DEMO_MODE=false; demo defaults are local-only.
JWT_SECRET=change-me-in-your-local-env
JWT_EXPIRE_MINUTES=120
SQL_ROW_LIMIT=200
SQL_TIMEOUT_S=10
# Optional provider test credentials. No mock order fallback is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
